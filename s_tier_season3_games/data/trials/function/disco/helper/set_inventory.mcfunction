# helper function that sets the inventory for all alive players

# set hotbar full of randomized block
execute as @s if score disco.handler disco.timer.game matches 1 if score disco.handler disco.current_round_block matches 1 run item replace entity @s hotbar.0 with minecraft:stripped_dark_oak_wood
