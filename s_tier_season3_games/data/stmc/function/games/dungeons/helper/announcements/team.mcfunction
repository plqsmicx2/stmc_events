# Team scores

execute run tellraw @a {text:"Team scores:",color:white}

execute if score RED_RACCOONS dungeons.points.team.rank matches 1 run tellraw @a [{text:"#1: ",color:yellow},{text:"Red Raccoons",color:red},{text:" - ",color:yellow},{score:{name:"RED_RACCOONS",objective:"dungeons.points.team"}}]
