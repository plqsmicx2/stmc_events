# give players necessary items

# is a one-time thing since keepInventory is on

# elytra
item replace entity @a armor.chest with elytra[unbreakable={}]

# tools
item replace entity @a hotbar.0 with netherite_sword[unbreakable={},enchantments={looting:3b}]
