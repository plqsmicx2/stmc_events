item replace entity @a hotbar.2 with netherite_pickaxe[unbreakable={},enchantments={efficiency:5b,silk_touch:1b}]
item replace entity @a hotbar.3 with netherite_axe[unbreakable={},enchantments={efficiency:5b}]
item replace entity @a hotbar.4 with netherite_shovel[unbreakable={},enchantments={efficiency:5b}]
item replace entity @a hotbar.8 with firework_rocket 64