# helper function that announces how many points each team scoaqua

# calculate team rankings
function stmc:games/trials/ascend/calculate_rankings

# <===== TEAM POINTS ANNOUNCEMENT =====>

tellraw @a {text:"Team score for ascend:",color:aqua}

