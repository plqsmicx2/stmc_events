#spear effects
execute as @a if items entity @s weapon.mainhand iron_spear run effect give @s invisibility 1 0 true
execute as @a if items entity @s weapon.mainhand golden_spear run effect give @s strength 1 2 true
execute as @a if items entity @s weapon.mainhand diamond_spear run effect give @s speed 1 0 true

#resistance on platform
execute as @a at @s if block ~ ~-1 ~ stone_bricks run effect give @s resistance 1 4 true
execute as @a at @s if block ~ ~-1 ~ bedrock run effect give @s resistance 1 4 true

#saturation
effect give @a saturation 1 255 true

# listen for kit interactions
function stmc:games/joust/utils/kit_listener